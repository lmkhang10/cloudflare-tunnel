{
  "name": "cloudflare-tunnel-kit",
  "version": "0.2.3",
  "description": "Safe, reusable Cloudflare Tunnel setup for custom and Laravel projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmkhang10/cloudflare-tunnel.git"
  },
  "homepage": "https://github.com/lmkhang10/cloudflare-tunnel#readme",
  "bugs": {
    "url": "https://github.com/lmkhang10/cloudflare-tunnel/issues"
  },
  "type": "module",
  "bin": {
    "cf-tunnel": "dist/cli/main.js",
    "cftunnel": "dist/cli/main.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test --test-timeout=10000 tests/**/*.test.js",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "electron": "44.4.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
